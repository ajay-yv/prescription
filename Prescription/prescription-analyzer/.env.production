# Production Environment Variables
REACT_APP_NAME=Prescription Analyzer
GENERATE_SOURCEMAP=false

# Server base URL - leave empty for Vercel (uses same domain)
REACT_APP_SERVER_BASE=

# Translation API settings
LIBRETRANSLATE_BASE=https://libretranslate.de
LIBRETRANSLATE_API_KEY=

# TTS settings (optional - browser TTS will be used by default)
USE_GOOGLE_TTS=false
# If USE_GOOGLE_TTS=true, set GOOGLE_APPLICATION_CREDENTIALS in Vercel dashboard
