# optional custom translate endpoint (if you have one)
REACT_APP_TRANSLATE_API_URL=https://your-translate-endpoint/translate
REACT_APP_TRANSLATE_API_KEY=your_api_key_if_needed

# optional TTS server fallback (if browser TTS not available)
REACT_APP_TTS_API_URL=https://your-tts-endpoint/text-to-speech
PORT=5050
LIBRETRANSLATE_BASE=https://libretranslate.com
LIBRETRANSLATE_API_KEY=your_libretranslate_api_key_here   # optional; recommended
USE_GOOGLE_TTS=false
# If USE_GOOGLE_TTS=true, also set GOOGLE_APPLICATION_CREDENTIALS path to your service account json
REACT_APP_SERVER_BASE=http://localhost:5050
